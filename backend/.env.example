# Copy to .env (never commit .env) or set these in your Render dashboard.

# FREE option: Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Paid option: Claude key from https://console.anthropic.com
# ANTHROPIC_API_KEY=

# Optional overrides
# AGENT_PROVIDER=gemini        # gemini | anthropic (auto-detected from the keys above)
# AGENT_MODEL=gemini-3.1-flash-lite
